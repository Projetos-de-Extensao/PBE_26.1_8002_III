@startuml

' --- Estilos ---
skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
}

' --- Enums ---
enum Unidade {
    BARRA
    BOTAFOGO
}

enum Periodo {
    PRIMEIRO, SEGUNDO, TERCEIRO, QUARTO, QUINTO, SEXTO, SETIMO, OITAVO, NONO, DECIMO
}

enum TipoUsuario {
    ALUNO
    SECRETARIA
    COORDENACAO
    CARREIRAS
}

' --- Classes de Usuários ---
abstract class Usuario {
    # matricula : string
    # nome : string
    # email : string
    # senha : string
    # unidade : Unidade
}

class Aluno extends Usuario {
    - cpf : string
    - is_ativo : bool
    - periodo : Periodo
    - cursoId : int
}

class Secretaria extends Usuario {
}

class Coordenador extends Usuario {
    - areaId : int
}

@enduml
