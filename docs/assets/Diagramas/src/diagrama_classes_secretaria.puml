@startuml

' --- Estilos ---
skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
}

' --- Classes Relevantes ---
abstract class Usuario {
    # matricula : string
    # nome : string
    # email : string
    # senha : string
    # unidade : Unidade
}

class Secretaria extends Usuario {
}

class Processo {
    - id : int
    - nome_empresa : string
    - data_criacao : Date
    - status : StatusProcesso
    - matricula_aluno : int
    + nome_processo() : string
}

class Aluno {
    - cpf : string
    - is_ativo : bool
    - periodo : Periodo
    - cursoId : int
}

' --- Relacionamentos ---
Secretaria "1" -- "0..*" Processo : audita >
Secretaria "1" -- "0..*" Aluno : pesquisa >

@enduml
