# Django Core
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — origens permitidas (separar por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL para produção)
# DATABASE_URL=postgres://user:password@localhost:5432/ibintern

# Celery Configuration
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://

# Email (SMTP real — Mailtrap para dev, SendGrid/SES para prod)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=

# Api Gemini
GEMINI_API_KEY=

# Metabase Embedding
METABASE_SITE_URL=http://localhost:3000
METABASE_SECRET_KEY=my-metabase-dev-secret-key-change-in-production