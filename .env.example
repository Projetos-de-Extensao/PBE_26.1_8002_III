# Django Core
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — origens permitidas (separar por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (Supabase — PostgreSQL remoto)
# Obtenha a connection string em: Supabase Dashboard > Settings > Database > Connection string > URI
# Use o modo "Transaction pooler" (porta 6543) para melhor performance com Django.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Celery Configuration
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://
# True para testes locais sem broker (síncrono); False para envio ao RabbitMQ/Celery Worker
CELERY_TASK_ALWAYS_EAGER=True

# Email (SMTP real — Mailtrap para dev, SendGrid/SES para prod)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=

# Api Gemini
GEMINI_API_KEY=

# Metabase Embedding
METABASE_SITE_URL=http://localhost:3000
METABASE_SECRET_KEY=my-metabase-dev-secret-key-change-in-production

# Metabase Dashboard IDs (ajuste conforme os dashboards criados no Metabase)
METABASE_DASHBOARD_SECRETARIA=1
METABASE_DASHBOARD_COORDENADOR=2
